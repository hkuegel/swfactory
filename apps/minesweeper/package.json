{
  "name": "@swfactory/minesweeper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:dist": "node ../../scripts/check-dist.mjs minesweeper",
    "measure:fps": "node scripts/measure-fps.mjs",
    "verify": "npm run verify -w @swfactory/platform && npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run check:dist"
  },
  "dependencies": {
    "@swfactory/platform": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0"
  }
}
