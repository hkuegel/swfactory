# Copy this file to .env.local (gitignored) and fill in your own values.
# See README.md, "Google sign-in setup", for how to create the OAuth client.

# OAuth 2.0 client ID of type "Web application" from Google Cloud Console.
# Not a secret (it ends up in the bundle), but per developer/environment, so not committed.
# If empty, the app still runs; "Sign in with Google" then shows the sign-in error.
VITE_GOOGLE_CLIENT_ID=
