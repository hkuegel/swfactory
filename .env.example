# Copy this file to .env.local in the repo root (gitignored) and fill in your own values.
# One file for every app: all apps read it from the repo root.
# See README.md, "Google sign-in setup", for how to create the OAuth client.

# OAuth 2.0 client ID of type "Web application" from Google Cloud Console.
# Not a secret (it ends up in the bundle), but per developer/environment, so not committed.
# If empty, the app still runs; "Sign in with Google" then shows the sign-in error.
VITE_GOOGLE_CLIENT_ID=

# VITE_GUEST_ONLY: builds the app with guest sign-in only (no Google). Only `npm run build:pages`
# sets it, for the GitHub Pages build. Never set it in .env.local; it would hide Google sign-in
# in your local runs. (Comment only, deliberately no assignment line.)
